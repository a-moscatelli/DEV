  <bpmn:collaboration id="Collaboration_1dl046b" name="model1-cacioepepe">
    <bpmn:participant id="Participant_0idb9tt" name="COOKING &#34;CACIO-E-PEPE&#34; (A CHEESE AND BLACK PEPPER SPAGHETTI DISH)" processRef="Process_c0wa1br" />
    <bpmn:textAnnotation id="TextAnnotation_05oxe2f">
      <bpmn:text>temperature in CUP is lower than 70° C (usu. after one minute) (to prevent clot)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0vyzukv">
      <bpmn:text>temperature in PAN is lower than 70° C
(to prevent clot)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_14dntnv">
      <bpmn:text>we have got everything we need, let's start !</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0r1605h">
      <bpmn:text>use mild, non-aged  Pecorino Romano</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0zsrhwu">
      <bpmn:text>use bronze-drawn spaghetti</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0unbq3m">
      <bpmn:text>in grains to be crushed, not ground</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_18foeu5">
      <bpmn:text>= keep dropping a ladle of cooking water from the POT to the PAN bit by bit</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ef0zo5" associationDirection="None" sourceRef="Event_01ot7hc" targetRef="TextAnnotation_0vyzukv" />
